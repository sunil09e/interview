# Execute commands while BUILDING the image
RUN apt-get update && \
    apt-get install -y nginx curl && \     Both Nginx and curl are installed.
    rm -rf /var/lib/apt/lists/*          Removes downloaded package-list files to reduce the final image size.  Remove unnecessary apt lists
RUN
RUN apt update                                     this also work
RUN apt install -y nginx

Runs during image build.
docker build
      ↓
RUN executes
      ↓
Image created

RUN ["apt", "update"]                         this is the proper pattern to bring your dockerfile
RUN ["apt", "install", "-y", "nginx"]
