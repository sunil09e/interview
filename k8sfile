metadata:
  name: myapp-secret

spec:
  refreshInterval: 1h

  secretStoreRef:
    name: aws-secretstore
    kind: SecretStore

  target:
    name: app-secret

  data:
    - secretKey: DB_USERNAME
      remoteRef:
        key: myapp/database
        property: DB_USERNAME

    - secretKey: DB_PASSWORD
