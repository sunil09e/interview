      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:ap-south-1:123456789012:secret:myapp/database-*"
    }
  ]
}

This basically says:  "You are allowed to read this particular secret from AWS Secrets Manager."



